# ============================================================
# trading-ai-bot 환경변수 설정
# 이 파일을 복사해서 .env 로 저장하고 실제 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요!
# ============================================================

# ────────────────────────────────────────
# 한국투자증권 KIS API
# https://apiportal.koreainvestment.com
# ────────────────────────────────────────
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=your_account_number-01
# 모의투자: true  /  실전투자: false (실전은 신중하게!)
KIS_PAPER_TRADE=true
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443  # 모의투자 URL
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443  # 실전 URL
KIS_WS_URL=ws://ops.koreainvestment.com:21000             # 모의 WebSocket
# KIS_WS_URL=ws://ops.koreainvestment.com:21000           # 실전 WebSocket

# ────────────────────────────────────────
# Anthropic Claude API
# https://console.anthropic.com
# ────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ────────────────────────────────────────
# 텔레그램 봇
# @BotFather 에서 생성
# ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ────────────────────────────────────────
# 데이터 수집 API
# ────────────────────────────────────────
# DART OpenAPI (공시/재무제표): https://opendart.fss.or.kr
DART_API_KEY=your_dart_key

# 네이버 검색 API: https://developers.naver.com
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_secret

# Finnhub (글로벌 뉴스): https://finnhub.io
FINNHUB_API_KEY=your_finnhub_key

# FRED API (미국 매크로): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key

# NewsAPI (선택): https://newsapi.org
NEWSAPI_KEY=your_newsapi_key

# ────────────────────────────────────────
# 데이터베이스
# ────────────────────────────────────────
DB_USER=trading_user
DB_PASSWORD=your_secure_password_here
DB_NAME=trading
DB_HOST=localhost
DB_PORT=5432
TIMESCALE_URL=postgresql://trading_user:your_secure_password_here@localhost:5432/trading

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ────────────────────────────────────────
# 웹 대시보드 서버
# ────────────────────────────────────────
DASHBOARD_PORT=8000
SECRET_KEY=your_very_long_random_secret_key_here_change_this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ────────────────────────────────────────
# 운영 설정
# ────────────────────────────────────────
# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 시간대
TIMEZONE=Asia/Seoul

# 모델 저장 경로
MODEL_PATH=./models

# 데이터 저장 경로
DATA_PATH=./storage_files
